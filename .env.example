# ParkPulse Environment Configuration
# ==============================================================================
# Dual-Mode Operation:
# 1. LOCAL/OFFLINE MODE: Leave VITE_API_BASE_URL blank or commented out.
#    ParkPulse will run 100% self-contained in browser LocalStorage.
#
# 2. CLOUD MODE: Set VITE_API_BASE_URL to your deployed cloud backend or local server.
#    Example local server:  http://localhost:5000
#    Example cloud backend: https://parkpulse-api.onrender.com (or AWS API Gateway endpoint)
# ==============================================================================

VITE_API_BASE_URL=

